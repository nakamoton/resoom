{
  "name": "resoom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "ota:search": "tsx scripts/ota-search.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "dev": "pnpm --filter @resoom/web dev",
    "build": "pnpm --filter @resoom/web build"
  },
  "dependencies": {
    "@resoom/adapters": "workspace:*",
    "@resoom/core": "workspace:*",
    "@resoom/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
