{
  "name": "resoom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "db:seed": "tsx scripts/db-seed.ts",
    "dev": "pnpm --filter @resoom/web dev",
    "build": "pnpm --filter @resoom/web build",
    "availability": "tsx scripts/availability-search.ts",
    "crawl": "tsx scripts/crawl.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "bundle:scripts": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@resoom/adapters": "workspace:*",
    "@resoom/core": "workspace:*",
    "@resoom/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
